<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Live Preview Video View (360 Stream) -->
    <TextureView
        android:id="@+id/videoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/modeCarousel"
        android:layout_below="@id/topBar" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#CC111111"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disconnected (Wi-Fi 5.8GHz)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConnectWifi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#00E676"
            android:text="Connect Wi-Fi"
            android:textColor="#000000"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- AI Assistant Floating Chip -->
    <LinearLayout
        android:id="@+id/aiAssistantChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_margin="12dp"
        android:background="#991E1E2C"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 AI: "
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to connect camera via local Wi-Fi."
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mode Carousel (Photo / Video / HDR / Timelapse) -->
    <HorizontalScrollView
        android:id="@+id/modeCarousel"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_above="@id/shutterBar"
        android:background="#1A1A1A"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="LOG" android:textColor="#888888" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="TIMELAPSE" android:textColor="#888888" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="PHOTO" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="VIDEO" android:textColor="#888888" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="HDR" android:textColor="#888888" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Shutter & Quick Media Controls Bar -->
    <RelativeLayout
        android:id="@+id/shutterBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_above="@id/bottomNavBar"
        android:background="#121212"
        android:paddingHorizontal="24dp">

        <!-- Quick Gallery Button (Left) -->
        <Button
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:backgroundTint="#333333"
            android:text="🖼️"
            android:textSize="16sp" />

        <!-- Main Shutter / REC Button (Center) -->
        <Button
            android:id="@+id/btnRecordVideo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_centerInParent="true"
            android:backgroundTint="#FF3D00"
            android:text="REC"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Take Photo Quick Button (Right) -->
        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#333333"
            android:text="📸"
            android:textSize="16sp" />
    </RelativeLayout>

    <!-- Bottom Navigation Bar (Insta360 Style - 5 Tabs) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#0A0A0A"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@android:color/transparent" android:text="Home" android:textColor="#888888" android:textSize="10sp" />
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@android:color/transparent" android:text="Album" android:textColor="#888888" android:textSize="10sp" />
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@android:color/transparent" android:text="Camera" android:textColor="#00E676" android:textSize="10sp" android:textStyle="bold" />
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@android:color/transparent" android:text="Stories" android:textColor="#888888" android:textSize="10sp" />
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@android:color/transparent" android:text="AI Me" android:textColor="#888888" android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>
