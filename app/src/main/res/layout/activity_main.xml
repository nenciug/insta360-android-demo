<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- 360 Live Preview Viewport -->
    <TextureView
        android:id="@+id/videoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#99000000">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disconnected"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConnectWifi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#00E676"
            android:text="Connect Wi-Fi"
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- AI Companion Assistant Overlay -->
    <TextView
        android:id="@+id/tvAiMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/controlsLayout"
        android:layout_margin="16dp"
        android:background="#CC1E1E1E"
        android:padding="12dp"
        android:text="🤖 AI Assistant Ready: Connect your Insta360 camera via Wi-Fi."
        android:textColor="#00E676"
        android:textSize="13sp" />

    <!-- Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#CC1A1A1A"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#333333"
            android:text="Photo"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRecordVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#D32F2F"
            android:text="REC"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#1976D2"
            android:text="AI Album"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
